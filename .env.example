# Local development only. Copy to .env; these credentials match docker-compose.yml.
DATABASE_URL=postgresql://janus:janus@127.0.0.1:55432/janus
DATABASE_URL_TEST=postgresql://janus:janus@127.0.0.1:55432/janus_test

# Only needed to record LLM fixtures (pnpm --filter @janus/orchestrator-api llm:record-fixture).
# Tests never use it: they replay recordings.
ANTHROPIC_API_KEY=

# Docker socket proxy from docker-compose.yml; the sandbox refuses to talk to Docker any other way.
DOCKER_HOST=tcp://127.0.0.1:23750

# Redis from docker-compose.yml, used by the BullMQ agent-sessions queue.
REDIS_URL=redis://127.0.0.1:56379
