{
  "name": "janus-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:sandbox": "pnpm --filter @janus/orchestrator-api test:sandbox",
    "db:migrate": "pnpm --filter @janus/orchestrator-api db:migrate",
    "run:replay": "node scripts/run-replay.mjs",
    "run:report": "node scripts/run-report.mjs",
    "run:start": "node scripts/run-start.mjs",
    "run:surface": "node scripts/run-surface.mjs",
    "run:ab-auto": "node scripts/run-ab-auto.mjs",
    "run:ui-engineer": "node scripts/run-ui-engineer.mjs",
    "check:arch": "turbo run build && depcruise --config .dependency-cruiser.cjs apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
