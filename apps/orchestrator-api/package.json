{
  "name": "@janus/orchestrator-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/interface/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "llm:record-fixture": "pnpm run build && node dist/interface/cli/record-fixture.js",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "observation:capture-fixtures": "pnpm run build && node dist/interface/cli/capture-observation-fixtures.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@janus/friction-engine": "workspace:*",
    "@janus/observation-builder": "workspace:*",
    "@janus/shared-kernel": "workspace:*",
    "@janus/stats": "workspace:*",
    "@janus/synthlab-report": "workspace:*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.0",
    "dependency-cruiser": "^18.7.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-vitals": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1"
  }
}
